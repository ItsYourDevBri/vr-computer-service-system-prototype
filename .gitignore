# Dependencies and generated build output
node_modules/
dist/
dist-ssr/
coverage/

# Local environment and secrets
.env
.env.*
!.env.example
*.local

# Logs, caches, and temporary files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp
*.bak

# Generated browser-test output
playwright-report/
test-results/
blob-report/

# Local implementation archives and visual QA captures
/artifacts/

# Blender source is retained locally. Publish only the current reusable master;
# runtime GLBs required by the app are tracked separately under public/.
/blender_assets/*
!/blender_assets/ATX_Mid_Tower_Master.blend
*.blend1
*.blend2
*.blend.bak

